<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
    <Metadata>
        <Identity Language="en-US" Id="php-fold-imports" Version="0.0.1" Publisher="eugenegpil" />
        <DisplayName>PHP Fold Imports</DisplayName>
        <Description xml:space="preserve">Folding ranges for PHP, with the top-level use block tagged as imports so it collapses on open.</Description>
        <Tags>php,folding,imports,use,fold</Tags>
        <Categories>Programming Languages</Categories>
        <GalleryFlags>Public</GalleryFlags>
        <Properties>
            <Property Id="Microsoft.VisualStudio.Code.Engine" Value="^1.80.0" />
            <Property Id="Microsoft.VisualStudio.Code.ExtensionDependencies" Value="" />
            <Property Id="Microsoft.VisualStudio.Code.ExtensionPack" Value="" />
            <Property Id="Microsoft.VisualStudio.Code.ExtensionKind" Value="workspace" />
            <Property Id="Microsoft.VisualStudio.Code.LocalizedLanguages" Value="" />
            <Property Id="Microsoft.VisualStudio.Services.Links.Source" Value="https://github.com/EugeneGpil/php-fold-imports.git" />
            <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://github.com/EugeneGpil/php-fold-imports.git" />
            <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/EugeneGpil/php-fold-imports.git" />
            <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/EugeneGpil/php-fold-imports/issues" />
            <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://github.com/EugeneGpil/php-fold-imports#readme" />
            <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#4F5B93" />
            <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark" />
            <Property Id="Microsoft.VisualStudio.Services.GitHubFlavoredMarkdown" Value="true" />
        </Properties>
        <Icon>extension/icon.png</Icon>
    </Metadata>
    <Installation>
